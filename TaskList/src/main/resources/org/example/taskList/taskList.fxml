<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>

<?import javafx.scene.control.ListView?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.taskList.TaskListController">
    <!--new task bar-->
    <HBox>
        <Label text="New Task:" alignment="TOP_LEFT" style="-fx-padding: 5 5 5 5" onKeyPressed="#onAdd"/>
        <TextField fx:id="textField"/>
    </HBox>

    <!--task list-->
    <ListView fx:id="listView">
    </ListView>

    <!--button bar-->
    <HBox alignment="BOTTOM_CENTER" spacing="5.0" xmlns:fx="http://javafx.com/fxml">
        <Button text="Add Task" onAction="#onAdd"/>
        <Button fx:id="removeBttn" text="Remove Task" onAction="#onRemove"/>
        <Button fx:id="completeBttn" text="Complete Task" onAction="#onComplete"/>
    </HBox>
</VBox>
